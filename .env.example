# Fleet authentication
FLEET_MONGODB_URI=
FLEET_AUTH_ENCRYPTION_KEY=
FLEET_AUTH_ORIGIN=http://localhost:4001

# Cloudflare Turnstile (see docs/authentication-api.md for local test keys)
NEXT_PUBLIC_FLEET_TURNSTILE_SITE_KEY=
FLEET_TURNSTILE_SECRET_KEY=
FLEET_TURNSTILE_HOSTNAME=localhost

# Opt in only when running the development seed
FLEET_ALLOW_DEV_SEED=0
