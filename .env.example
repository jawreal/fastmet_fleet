# Local Docker services (generate separate hex passwords for MongoDB and Redis)
# Use the same MongoDB password in both settings.
FLEET_MONGO_PASSWORD=replace_with_local_mongo_password
FLEET_MONGODB_URI=mongodb://fleet_dev:replace_with_local_mongo_password@127.0.0.1:27017/fleet_dev?authSource=admin
REDIS_HOST=127.0.0.1
REDIS_PORT=14639
REDIS_PASSWORD=replace_with_local_redis_password
REDIS_TLS=false

# Fleet authentication
FLEET_AUTH_ENCRYPTION_KEY=
FLEET_AUTH_ORIGIN=http://localhost:4001
# Fleet asks this backend for the document checklist, image previews, and replacement uploads.
# Fleet and the backend must use the same MongoDB database.
FLEET_BACKEND_URL=http://localhost:3000

# Cloudflare Turnstile (see docs/authentication-api.md for local test keys)
NEXT_PUBLIC_FLEET_TURNSTILE_SITE_KEY=
FLEET_TURNSTILE_SECRET_KEY=
FLEET_TURNSTILE_HOSTNAME=localhost

# Opt in only when running the development seed
FLEET_ALLOW_DEV_SEED=0
