{
  "name": "fastmet_fleet",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=24.0.0 <27.0.0"
  },
  "scripts": {
    "dev": "node scripts/check-node.mjs && next dev",
    "dev:custom": "node scripts/check-node.mjs && next dev -p 4001",
    "build": "node scripts/check-node.mjs && next build",
    "start": "node scripts/check-node.mjs && next start",
    "lint": "oxlint",
    "typecheck": "next typegen && tsc --noEmit",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "prepare": "husky || true",
    "seed:fleet-auth": "node --env-file=.env.local scripts/seed-fleet-auth.mjs",
    "test:fleet-auth": "node --test scripts/fleet-auth.test.mjs"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/modifiers": "^9.0.0",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@hookform/resolvers": "^7.0.6",
    "@tanstack/react-table": "^9.3.1",
    "@zxcvbn-ts/core": "^4.3.0",
    "@zxcvbn-ts/language-common": "^4.2.0",
    "@zxcvbn-ts/language-en": "^4.1.2",
    "bcryptjs": "^3.0.3",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.2",
    "date-fns": "^4.4.0",
    "emoji-picker-react": "^5.1.4",
    "ioredis": "^5.11.1",
    "lucide-react": "^1.70.0",
    "mongodb": "^7.9.1",
    "next": "16.4.5",
    "next-themes": "^0.4.6",
    "otpauth": "^9.6.0",
    "qrcode": "^1.5.4",
    "react": "19.3.0",
    "react-day-picker": "^10.0.2",
    "react-dom": "19.3.0",
    "react-hook-form": "^7.92.0",
    "recharts": "3.8.0",
    "server-only": "^0.0.1",
    "shadcn": "^4.23.0",
    "sonner": "^2.0.8",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^20",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "mongodb-memory-server-core": "^11.4.0",
    "oxfmt": "^0.79.0",
    "oxlint": "^1.93.0",
    "tailwindcss": "^4",
    "typescript": "^5"
  },
  "packageManager": "pnpm@12.11.2"
}
